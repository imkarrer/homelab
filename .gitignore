result
result-*
.direnv

# Machine-specific, generated by nixos-generate-config. Fetch read-only from
# the box; never invent one. Only the .example is tracked.
hosts/*/hardware-configuration.nix

# Public keys are not secret, but keep the tracked/local split ac-host uses.
hosts/*/ssh-keys.local.nix

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
